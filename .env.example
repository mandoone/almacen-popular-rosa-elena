# Variables de entorno del proyecto.
# Copia este archivo como `.env.local` y completa los valores reales.
# NUNCA commitees `.env.local` ni pongas valores reales aqui.

# ── Entorno de la aplicacion ───────────────────────────────────────────────────

# 'production' | 'test' | 'demo' | 'local'. Vacio o cualquier otro valor se
# trata como "desconocido" y usa las variables productivas de abajo, igual
# que si esta variable no existiera (ver src/lib/env.ts). Solo con
# NEXT_PUBLIC_APP_ENV=test el backend de pedidos usa las variables _TEST.
# Es NEXT_PUBLIC_ a proposito (puede mostrarse en la UI, p.ej. un banner
# "TEST"), pero NUNCA debe tener este prefijo una variable con secretos.
NEXT_PUBLIC_APP_ENV=

# Origen público definitivo, sin ruta final (ej.: https://www.ejemplo.cl).
# Habilita canonical, sitemap y referencia de sitemap en robots.txt.
SITE_URL=

# ── Backend de pedidos (Apps Script Web App) ──────────────────────────────────

# URL .../exec de la Web App de Apps Script (scripts/apps-script-pedidos.gs).
GOOGLE_SCRIPT_PEDIDOS_URL=

# Token admin definido en el Apps Script (ADMIN_TOKEN). Solo se usa en el servidor.
GOOGLE_SCRIPT_ADMIN_TOKEN=

# ── Backend de pedidos TEST (solo si NEXT_PUBLIC_APP_ENV=test) ────────────────
# Deployment separado del productivo. Ver docs/fase-3b/ENTORNO_TEST_FASE_3B.md.
# Nunca deben tener el mismo valor que las variables productivas de arriba:
# src/lib/env.ts bloquea el arranque si coinciden.

# URL .../exec de la Web App de Apps Script TEST.
GOOGLE_SCRIPT_PEDIDOS_URL_TEST=

# Token admin del Apps Script TEST. Distinto del token productivo.
GOOGLE_SCRIPT_ADMIN_TOKEN_TEST=

# ── Panel de administración ───────────────────────────────────────────────────

# Recuperación legacy solo para TEST/local. Se ignora en Producción y cuando hay
# cuentas individuales, salvo que ADMIN_LEGACY_RECOVERY_ENABLED=true en TEST/local.
ADMIN_PANEL_PASSWORD=
ADMIN_LEGACY_RECOVERY_ENABLED=false

# JSON compacto con cuentas individuales. Cada cuenta contiene actor_id, rol,
# active, session_version y password_hash PBKDF2; nombre es opcional. Nunca usar
# nombres reales hasta que el Almacén confirme la asignación.
ADMIN_USERS_JSON=

# Secret para firmar la cookie de sesión admin (HMAC-SHA256). Mínimo 32 chars.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_SECRET_VERSION=v1

# Durante una rotación se puede conservar UNA clave anterior temporalmente.
# Retirarla al vencer el máximo de sesión (8 horas).
ADMIN_SESSION_SECRET_PREVIOUS=
ADMIN_SESSION_SECRET_PREVIOUS_VERSION=
